# Copy to .env.local and fill in. Leave Supabase empty to run on seeded demo data.

# ── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Gemma via OpenRouter ──────────────────────────────────
# DEV ONLY: a VITE_ variable is shipped to the browser. In production set the key as a
# Supabase secret instead:  supabase secrets set OPENROUTER_API_KEY=sk-or-...
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# auto | edge | direct | heuristic
#   auto = edge when Supabase is set, else direct when a key is set, else offline rules
VITE_AI_MODE=auto
