# Copy to .env and fill in. The app needs a Supabase project — there is no offline/demo mode.

# ── Supabase ──────────────────────────────────────────────
# Project URL + publishable (anon) key — both are safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Gemma via OpenRouter ──────────────────────────────────
# The key lives ONLY in Supabase secrets (never in a VITE_ variable):
#   supabase secrets set OPENROUTER_API_KEY=sk-or-...
# This is just the model name shown in the UI; the edge function reads OPENROUTER_MODEL.
VITE_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
